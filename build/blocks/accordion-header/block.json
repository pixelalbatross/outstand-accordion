{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "outstand/accordion-header",
  "version": "1.0.0",
  "title": "Accordion Header",
  "category": "design",
  "icon": "heading",
  "parent": [
    "outstand/accordion-item"
  ],
  "description": "A heading with the button that shows or hides the panel.",
  "textdomain": "outstand-accordion",
  "allowedBlocks": [
    "outstand/accordion-icon"
  ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "level": {
      "type": "number",
      "default": 2
    },
    "textAlign": {
      "type": "string"
    }
  },
  "usesContext": [
    "outstand/accordion-item-id",
    "outstand/accordion-is-open"
  ],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "gradients": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "__experimentalSkipSerialization": [
        "padding"
      ],
      "__experimentalDefaultControls": {
        "padding": true
      }
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalTextDecoration": true,
      "__experimentalLetterSpacing": true,
      "__experimentalDefaultControls": {
        "fontSize": true,
        "fontFamily": true
      }
    },
    "shadow": true,
    "layout": {
      "allowSwitching": false,
      "allowInheriting": false,
      "default": {
        "type": "flex",
        "flexWrap": "nowrap",
        "justifyContent": "space-between",
        "verticalAlignment": "center"
      }
    },
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}